# SafariSacco Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.

# Django Application Security
SECRET_KEY=django-insecure-change-this-in-production-safarisacco-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.onrender.com

# Database Connection (PostgreSQL or fallback to SQLite)
# Example: postgresql://user:password@localhost:5432/safarisacco_db
DATABASE_URL=

# Celery & Redis Task Broker
REDIS_URL=redis://localhost:6379/0

# Safaricom M-Pesa STK Push & Webhook Configuration
MPESA_PAYBILL=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_WEBHOOK_SECRET=sacco-secure-webhook-secret-key

# Google OAuth Credentials
